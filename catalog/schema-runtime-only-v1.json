{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thedavidweng/openkara-models/catalog/schema-runtime-only-v1.json",
  "title": "OpenKara runtime-only promotion evidence",
  "description": "External qualification record plus the immutable native-comparison and OpenKara app-integration reports it references. The record lives outside the immutable release manifest, so there is no manifest/evidence hash cycle.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "shape": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "report_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "size",
        "sha256",
        "report_id",
        "schema_version"
      ],
      "properties": {
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+/releases/download/[^/]+/[^/]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "manifest_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "model_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cold_load_s",
        "first_window_s",
        "warm_median_s",
        "warm_p95_s",
        "warm_iters",
        "peak_rss_kb",
        "rss_delta_kb",
        "requested_provider",
        "assigned_provider",
        "used_fallback",
        "provider_node_count",
        "total_node_count",
        "fallback_node_count",
        "finite_output",
        "output_shapes",
        "installed_size",
        "archive_bytes",
        "archive_sha256",
        "frames",
        "audio_duration_s",
        "rtf_warm",
        "header_provenance"
      ],
      "properties": {
        "cold_load_s": {
          "type": "number",
          "minimum": 0
        },
        "first_window_s": {
          "type": "number",
          "minimum": 0
        },
        "warm_median_s": {
          "type": "number",
          "minimum": 0
        },
        "warm_p95_s": {
          "type": "number",
          "minimum": 0
        },
        "warm_iters": {
          "type": "integer",
          "minimum": 1
        },
        "peak_rss_kb": {
          "type": "number",
          "minimum": 0
        },
        "rss_delta_kb": {
          "type": "number"
        },
        "requested_provider": {
          "type": "string",
          "enum": [
            "cpu",
            "coreml",
            "xnnpack",
            "directml"
          ]
        },
        "assigned_provider": {
          "type": "string",
          "minLength": 1
        },
        "used_fallback": {
          "type": "boolean"
        },
        "provider_node_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_node_count": {
          "type": "integer",
          "minimum": 0
        },
        "fallback_node_count": {
          "type": "integer",
          "minimum": 0
        },
        "finite_output": {
          "type": "boolean"
        },
        "output_shapes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shape"
          }
        },
        "installed_size": {
          "type": "integer",
          "minimum": 1
        },
        "archive_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "audio_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rtf_warm": {
          "type": "number",
          "minimum": 0
        },
        "header_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "upstream_commit_sha",
            "ort_api_version",
            "files"
          ],
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "packaged",
                "pinned"
              ]
            },
            "upstream_commit_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "ort_api_version": {
              "type": "integer",
              "minimum": 1
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "sha256",
                  "size"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "native_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_artifact_id",
        "baseline_runtime_artifact_id",
        "candidate_runtime_artifact_id",
        "target_triple",
        "execution_provider",
        "model_digest",
        "model_size",
        "baseline_runtime_digest",
        "baseline_runtime_size",
        "candidate_runtime_digest",
        "candidate_runtime_size"
      ],
      "properties": {
        "model_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline_runtime_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_runtime_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "target_triple": {
          "type": "string",
          "minLength": 1
        },
        "execution_provider": {
          "type": "string",
          "enum": [
            "cpu",
            "coreml",
            "xnnpack",
            "directml"
          ]
        },
        "model_digest": {
          "$ref": "#/$defs/sha256"
        },
        "model_size": {
          "type": "integer",
          "minimum": 1
        },
        "baseline_runtime_digest": {
          "$ref": "#/$defs/sha256"
        },
        "baseline_runtime_size": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_runtime_digest": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_runtime_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "native_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "model_files",
        "expected_output_shapes",
        "baseline",
        "candidate",
        "comparison",
        "checks"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/native_identity"
        },
        "model_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/model_file"
          }
        },
        "expected_output_shapes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shape"
          }
        },
        "baseline": {
          "oneOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate": {
          "oneOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "output_shapes_equal",
            "finite",
            "output_max_abs",
            "output_mse",
            "passed"
          ],
          "properties": {
            "output_shapes_equal": {
              "type": "boolean"
            },
            "finite": {
              "type": "boolean"
            },
            "output_max_abs": {
              "type": "number",
              "minimum": 0
            },
            "output_mse": {
              "type": "number",
              "minimum": 0
            },
            "passed": {
              "type": "boolean"
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "native_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "report_id",
        "created_at",
        "candidate_release_id",
        "generation",
        "candidate_manifest_sha256",
        "baseline_release_id",
        "baseline_manifest_sha256",
        "target_triple",
        "providers",
        "environment",
        "status",
        "edges"
      ],
      "properties": {
        "schema_version": {
          "const": "openkara.runtime-only-native-report/v1"
        },
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "candidate_release_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "baseline_release_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_triple": {
          "type": "string",
          "minLength": 1
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "cpu",
              "coreml",
              "xnnpack",
              "directml"
            ]
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "os_name",
            "arch",
            "machine",
            "python",
            "cpu_count",
            "target_triple",
            "rosetta_translated"
          ],
          "properties": {
            "os": {
              "type": "string",
              "minLength": 1
            },
            "arch": {
              "type": "string",
              "enum": [
                "aarch64",
                "x86_64"
              ]
            },
            "python": {
              "type": "string",
              "minLength": 1
            },
            "cpu_count": {
              "type": "integer",
              "minimum": 1
            },
            "os_name": {
              "type": "string",
              "enum": [
                "darwin",
                "linux",
                "windows"
              ]
            },
            "machine": {
              "type": "string",
              "minLength": 1
            },
            "target_triple": {
              "type": "string",
              "minLength": 1
            },
            "rosetta_translated": {
              "type": "boolean"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/native_edge"
          }
        }
      }
    },
    "app_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_artifact_id",
        "runtime_artifact_id",
        "target_triple",
        "execution_provider",
        "model_digest",
        "model_size",
        "runtime_digest",
        "runtime_size"
      ],
      "properties": {
        "model_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "runtime_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "target_triple": {
          "type": "string",
          "minLength": 1
        },
        "execution_provider": {
          "type": "string",
          "enum": [
            "cpu",
            "coreml",
            "xnnpack",
            "directml"
          ]
        },
        "model_digest": {
          "$ref": "#/$defs/sha256"
        },
        "model_size": {
          "type": "integer",
          "minimum": 1
        },
        "runtime_digest": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "app_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "loaded_library",
        "provider",
        "output_shapes",
        "finite_output",
        "audio_pipeline",
        "checks"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/app_identity"
        },
        "loaded_library": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "sha256"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested",
            "assigned",
            "used_fallback",
            "provider_node_count",
            "total_node_count",
            "fallback_node_count"
          ],
          "properties": {
            "requested": {
              "type": "string",
              "enum": [
                "cpu",
                "coreml",
                "xnnpack",
                "directml"
              ]
            },
            "assigned": {
              "type": "string",
              "minLength": 1
            },
            "used_fallback": {
              "type": "boolean"
            },
            "provider_node_count": {
              "type": "integer",
              "minimum": 0
            },
            "total_node_count": {
              "type": "integer",
              "minimum": 0
            },
            "fallback_node_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "output_shapes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shape"
          }
        },
        "finite_output": {
          "type": "boolean"
        },
        "audio_pipeline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frames_processed",
            "sample_rate",
            "stems",
            "finite"
          ],
          "properties": {
            "frames_processed": {
              "type": "integer",
              "minimum": 1
            },
            "sample_rate": {
              "const": 44100
            },
            "stems": {
              "type": "integer",
              "minimum": 1
            },
            "finite": {
              "type": "boolean"
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "app_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "report_id",
        "created_at",
        "candidate_release_id",
        "generation",
        "candidate_manifest_sha256",
        "openkara",
        "target_triple",
        "status",
        "edges"
      ],
      "properties": {
        "schema_version": {
          "const": "openkara.openkara-app-integration/v1"
        },
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "candidate_release_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "openkara": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "commit"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        },
        "target_triple": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/app_edge"
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "release_id",
        "generation",
        "manifest",
        "baseline_release_id",
        "baseline_manifest",
        "native_reports",
        "app_reports",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": "openkara.runtime-only-qualification/v1"
        },
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "manifest": {
          "$ref": "#/$defs/manifest_binding"
        },
        "baseline_release_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline_manifest": {
          "$ref": "#/$defs/manifest_binding"
        },
        "native_reports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/report_ref"
          }
        },
        "app_reports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/report_ref"
          }
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
