{
  "$id": "https://openkara.dev/quality/schema-quality-report-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Schema for the model correctness + quality report produced by scripts/run_quality_suite.py.",
  "properties": {
    "measurement_backend": {"enum": ["native-c-api", "python-wheel-conversion-only"], "type": "string"},
    "model_digest": {"additionalProperties": false, "properties": {"sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "size": {"minimum": 1, "type": "integer"}}, "required": ["sha256", "size"], "type": "object"},
    "provider": {"type": "string"},
    "runtime_archive": {"additionalProperties": false, "properties": {"installed_size": {"minimum": 0, "type": "integer"}, "name": {"type": "string"}, "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "size": {"minimum": 0, "type": "integer"}}, "required": ["name", "sha256", "size", "installed_size"], "type": "object"},
    "target": {"type": "string"},
    "model": {
      "type": "string"
    },
    "mse_threshold": {
      "minimum": 0,
      "type": "number"
    },
    "onnx_path": {
      "type": "string"
    },
    "results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string"
          },
          "expected_shape": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "expected_shape_match": {
            "type": "boolean"
          },
          "fixture_id": {
            "type": "string"
          },
          "mae": {
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "max_abs_error": {
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "mse": {
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "mse_threshold": {
            "description": "Effective MSE gate for this fixture: the per-fixture mse_budget from the corpus manifest when declared, else the tier threshold.",
            "type": "number"
          },
          "onnx_has_inf": {
            "type": "boolean"
          },
          "onnx_has_nan": {
            "type": "boolean"
          },
          "onnx_output_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "onnx_shape": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "pytorch_has_inf": {
            "type": "boolean"
          },
          "pytorch_has_nan": {
            "type": "boolean"
          },
          "pytorch_output_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "pytorch_shape": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "shape_match": {
            "type": "boolean"
          },
          "tier": {
            "type": "string"
          }
        },
        "required": [
          "fixture_id",
          "category",
          "tier",
          "onnx_shape",
          "pytorch_shape",
          "shape_match",
          "onnx_has_nan",
          "onnx_has_inf",
          "pytorch_has_nan",
          "pytorch_has_inf",
          "onnx_output_digest",
          "pytorch_output_digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "openkara.quality-report/v1",
      "type": "string"
    },
    "separation": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "chunk_boundary_error": {
            "type": "number"
          },
          "fixture_id": {
            "type": "string"
          },
          "leakage_db": {
            "type": "number"
          },
          "low_frequency_error_db": {
            "type": "number"
          },
          "mrstft_loss": {
            "type": "number"
          },
          "reference_bundle": {
            "additionalProperties": false,
            "properties": {
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "size": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "sha256",
              "size"
            ],
            "type": "object"
          },
          "sdr_db": {
            "type": "number"
          },
          "si_sdr_db": {
            "type": "number"
          },
          "transient_error": {
            "type": "number"
          }
        },
        "required": [
          "fixture_id",
          "reference_bundle",
          "si_sdr_db",
          "sdr_db",
          "leakage_db",
          "mrstft_loss",
          "transient_error",
          "low_frequency_error_db",
          "chunk_boundary_error"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "tier": {
      "enum": [
        "pr",
        "release"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "model",
    "onnx_path",
    "tier",
    "mse_threshold",
    "results"
  ],
  "title": "OpenKara quality report (v1)",
  "type": "object"
}
